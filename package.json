{
  "name": "@mayhem93/nexxus-cli",
  "version": "0.0.1",
  "description": "Nexxus CLI tool for administration and bootstrapping services",
  "type": "module",
  "bin": {
    "nexxus-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/schemas','dist/schemas',{recursive:true})\"",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "cli",
    "admin",
    "tool",
    "bootstrap",
    "realtime",
    "sync",
    "synchronization",
    "notifications",
    "backend",
    "baas"
  ],
  "author": "Răzvan Botea <contact@razvanbotea.me>",
  "license": "MPL-2.0",
  "dependencies": {
    "@mayhem93/nexxus-core-lib": "0.0.6",
    "@mayhem93/nexxus-database-lib": "0.0.7",
    "@mayhem93/nexxus-message-queue-lib": "0.0.6",
    "argparse": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.1",
    "@types/argparse": "^2.0.17",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0"
  }
}
